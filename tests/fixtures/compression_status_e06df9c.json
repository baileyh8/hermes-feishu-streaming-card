          "name": "COMPACTION_DONE_STATUS",
          "line": 78,
          "source": "COMPACTION_DONE_STATUS = \"✓ Context compaction complete — continuing turn...\"",
          "sha256": "27b0d475f440aba35347ad348a0c668684a3e05af2a748cabc37232062b647c4"
        },
        {
          "name": "_emit_compaction_done",
          "line": 91,
          "source": "def _emit_compaction_done(agent: Any) -> None:\n    \"\"\"Emit the structured terminal edge for a started compaction.\"\"\"\n    status_callback = getattr(agent, \"status_callback\", None)\n    if not status_callback:\n        return\n    with _swallow('status_callback error in compaction completion', exc_info=True):\n        status_callback(\"compacted\", COMPACTION_DONE_STATUS)",
          "sha256": "54cd774de22ce153aaa148f3838f831b9adefd8ae3756ae1bafd2940c4a86279"
        },
        {
          "name": "PREFLIGHT_COMPRESSION_STATUS_TEMPLATE",
          "line": 106,
          "source": "PREFLIGHT_COMPRESSION_STATUS_TEMPLATE = (\n    \"📦 Preflight compression: ~{tokens:,} tokens >= {threshold:,} threshold. This may take a moment.\"\n)",
          "sha256": "2435453216927942509191c9a8a05582969cfdb4ff7a6c7d0b2584e29c94eb5f"
        }
      ]
    },
